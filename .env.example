# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# VITE_GOOGLE_MAPS_API_KEY: Provisioned by AI Studio Google Maps integration.
VITE_GOOGLE_MAPS_API_KEY=""

# Cloud SQL (PostgreSQL) connection variables (injected automatically in AI Studio)
SQL_HOST="127.0.0.1"
SQL_USER=""
SQL_PASSWORD=""
SQL_DB_NAME=""
SQL_ADMIN_USER=""
SQL_ADMIN_PASSWORD=""
